{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tsurubami",
  "version": "0.1.0",
  "identifier": "fun.ghlg.tsurubami",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "tsurubami",
        "width": 340,
        "height": 340,
        "backgroundColor": "#00000000",
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "fullscreen": false,
        "skipTaskbar": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "icon": []
  }
}
